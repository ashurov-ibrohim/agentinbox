# Bu faylni nusxalab .env qiling va haqiqiy qiymatlarni to'ldiring.
# Render'ga deploy qilganda ham xuddi shu nomlar bilan Environment Variables
# bo'limiga qo'shiladi.

ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@host:5432/dbname
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/callback
GEMINI_API_KEY=
SECRET_KEY=
FRONTEND_URL=http://localhost:3000
